#!/usr/bin/env bash
# Grab a 1280x720 JPEG frame as a YouTube-thumbnail base. Seeks ~10% in (min 1s)
# so it works for both short clips and long videos.
set -uo pipefail
notify() { command -v notify-send >/dev/null && notify-send -a "Ryoku Creator" "$1" "${2:-}"; }
n=0
while IFS= read -r f; do
  [ -n "$f" ] || continue
  case "${f,,}" in *.mp4 | *.mov | *.mkv | *.webm | *.avi | *.m4v) ;; *) continue ;; esac
  dur="$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$f" 2>/dev/null)"
  ss="$(awk -v d="${dur:-0}" 'BEGIN{s=d*0.1; if(s<1)s=(d>1?1:0); printf "%.2f", s}')"
  out="${f%.*}_thumb.jpg"
  if ffmpeg -nostdin -y -ss "$ss" -i "$f" -frames:v 1 \
    -vf "scale=1280:720:force_original_aspect_ratio=increase,crop=1280:720" \
    -q:v 2 "$out" 2>/dev/null; then
    n=$((n + 1))
    notify "Grabbed thumbnail" "$(basename "$out")"
  else
    notify "Thumbnail failed" "$(basename "$f")"
  fi
done <<<"$NAUTILUS_SCRIPT_SELECTED_FILE_PATHS"
[ "$n" -gt 0 ] && notify "Done" "$n thumbnail(s)"

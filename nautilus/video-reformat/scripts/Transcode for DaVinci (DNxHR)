#!/usr/bin/env bash
# Convert to DNxHR HQ in a MOV (PCM audio). DaVinci Resolve free on Linux cannot
# import H.264/H.265 + AAC (licensing); this is the standard editable format.
set -uo pipefail
notify() { command -v notify-send >/dev/null && notify-send -a "Ryoku Creator" "$1" "${2:-}"; }
n=0
while IFS= read -r f; do
  [ -n "$f" ] || continue
  case "${f,,}" in *.mp4 | *.mov | *.mkv | *.webm | *.avi | *.m4v) ;; *) continue ;; esac
  out="${f%.*}_davinci.mov"
  if ffmpeg -nostdin -y -i "$f" \
    -c:v dnxhd -profile:v dnxhr_hq -pix_fmt yuv422p \
    -c:a pcm_s16le "$out" 2>/dev/null; then
    n=$((n + 1))
    notify "Ready for DaVinci" "$(basename "$out")"
  else
    notify "Convert failed" "$(basename "$f")"
  fi
done <<<"$NAUTILUS_SCRIPT_SELECTED_FILE_PATHS"
[ "$n" -gt 0 ] && notify "Done" "$n clip(s) for DaVinci"

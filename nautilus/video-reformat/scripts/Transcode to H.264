#!/usr/bin/env bash
# Transcode to universal H.264/AAC mp4 (shares/plays everywhere, Discord inline).
set -uo pipefail
notify() { command -v notify-send >/dev/null && notify-send -a "Ryoku Creator" "$1" "${2:-}"; }
n=0
while IFS= read -r f; do
  [ -n "$f" ] || continue
  case "${f,,}" in *.mp4 | *.mov | *.mkv | *.webm | *.avi | *.m4v) ;; *) continue ;; esac
  out="${f%.*}_h264.mp4"
  if ffmpeg -nostdin -y -i "$f" \
    -c:v libx264 -crf 20 -preset medium -pix_fmt yuv420p \
    -c:a aac -b:a 160k "$out" 2>/dev/null; then
    n=$((n + 1))
    notify "Transcoded to H.264" "$(basename "$out")"
  else
    notify "Transcode failed" "$(basename "$f")"
  fi
done <<<"$NAUTILUS_SCRIPT_SELECTED_FILE_PATHS"
[ "$n" -gt 0 ] && notify "Done" "$n video(s) to H.264"

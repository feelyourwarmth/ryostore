#!/usr/bin/env bash
# Turn a short clip into a clean looping GIF (two-pass palette, 480px wide, 15fps).
# Keep clips short (<~6s) or files balloon.
set -uo pipefail
notify() { command -v notify-send >/dev/null && notify-send -a "Ryoku Creator" "$1" "${2:-}"; }
n=0
while IFS= read -r f; do
  [ -n "$f" ] || continue
  case "${f,,}" in *.mp4 | *.mov | *.mkv | *.webm | *.avi | *.m4v) ;; *) continue ;; esac
  out="${f%.*}.gif"
  if ffmpeg -nostdin -y -i "$f" \
    -vf "fps=15,scale=480:-1:flags=lanczos,split[s0][s1];[s0]palettegen[p];[s1][p]paletteuse" \
    -loop 0 "$out" 2>/dev/null; then
    n=$((n + 1))
    notify "Made GIF" "$(basename "$out")"
  else
    notify "GIF failed" "$(basename "$f")"
  fi
done <<<"$NAUTILUS_SCRIPT_SELECTED_FILE_PATHS"
[ "$n" -gt 0 ] && notify "Done" "$n GIF(s)"

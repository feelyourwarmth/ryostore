{
  "id": "creator-deck",
  "name": "Creator Deck",
  "version": "0.1.0",
  "author": "Ryoku <releases@ryoku.dev>",
  "description": "A creator cockpit in the left sidebar: go live, set the aspect target, reformat the last recording, caption it, and jump to recent clips.",
  "license": "GPL-3.0-or-later",
  "tags": ["creator", "video", "sidebar"],
  "official": true,
  "entryPoints": {
    "main": "service/Main.qml",
    "content": "content/Widget.qml"
  },
  "files": [
    "assets/preview-popout.png"
  ],
  "capabilities": {
    "densities": ["full"]
  },
  "hosts": ["sidebarLeft"],
  "defaults": {
    "host": "sidebarLeft",
    "sidebarLeft": { "order": 40 },
    "icon": "movie",
    "label": "Creator"
  },
  "commands": ["bin/ryoku-creator-deck"]
}

#!/usr/bin/env bash
# Creator Deck engine: state + actions for the left-sidebar creator pane.
# The QML service polls `status` (JSON) and fires the action verbs below.
#
#   ryoku-creator-deck status                JSON: aspect, project, disk, mic, recent[]
#   ryoku-creator-deck aspect [9:16|1:1|16:9]  get or set the reformat target
#   ryoku-creator-deck project [<dir>]       get or set the project folder
#   ryoku-creator-deck golive                launch OBS (start streaming if configured)
#   ryoku-creator-deck edit                  launch the first editor found (kdenlive/resolve)
#   ryoku-creator-deck reformat-last         reformat the newest recording to the aspect target
#   ryoku-creator-deck caption-last          transcribe the newest recording to .srt (whisper.cpp)
#   ryoku-creator-deck reveal <path>         reveal a file in Nautilus
#   ryoku-creator-deck open-project          open the project folder in Nautilus
#   ryoku-creator-deck mic-toggle            mute/unmute the default source
#   ryoku-creator-deck fx-toggle             toggle the EasyEffects processing
set -uo pipefail

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/ryoku/creator"
state="$state_dir/state.json"
rec_dir="$HOME/Videos/Recordings"
mkdir -p "$state_dir"
[ -s "$state" ] || echo '{"aspect":"9:16"}' >"$state"

notify() { command -v notify-send >/dev/null && notify-send -a "Ryoku Creator" "$1" "${2:-}"; }
sget() { jq -r --arg k "$1" --arg d "$2" '.[$k] // $d' "$state" 2>/dev/null || echo "$2"; }
sset() {
  local tmp
  tmp="$(mktemp)"
  if jq --arg k "$1" --arg v "$2" '.[$k] = $v' "$state" >"$tmp" 2>/dev/null; then
    mv "$tmp" "$state"
  else
    rm -f "$tmp"
  fi
}

project_dir() {
  local p
  p="$(sget project "")"
  [ -n "$p" ] || p="$HOME/Videos"
  printf '%s\n' "$p"
}

aspect_dims() {
  case "$1" in
  1:1) echo "1080:1080" ;;
  16:9) echo "1920:1080" ;;
  *) echo "1080:1920" ;;
  esac
}

newest_recording() {
  find "$rec_dir" -maxdepth 1 -type f \( -iname '*.mp4' -o -iname '*.mkv' \) -printf '%T@\t%p\n' 2>/dev/null |
    sort -rn | head -1 | cut -f2-
}

mic_muted() {
  if command -v wpctl >/dev/null && wpctl get-volume @DEFAULT_AUDIO_SOURCE@ 2>/dev/null | grep -q MUTED; then
    echo true
  else
    echo false
  fi
}

disk_free() {
  local avail
  avail="$(df -B1 --output=avail "$(dirname "$rec_dir")" 2>/dev/null | tail -1 | tr -d ' ')"
  if [ -z "$avail" ]; then
    echo "?"
    return
  fi
  awk -v b="$avail" 'BEGIN{ g=b/1073741824; printf (g>=100? "%.0f GiB" : "%.1f GiB"), g }'
}

first_cmd() {
  local c
  for c in "$@"; do
    if command -v "$c" >/dev/null; then
      printf '%s\n' "$c"
      return 0
    fi
  done
  return 1
}

cmd_status() {
  local recent="[]" line path base
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    path="$line"
    base="$(basename "$path")"
    recent="$(jq --arg p "$path" --arg b "${base%.*}" '. + [{path:$p,label:$b}]' <<<"$recent")"
  done < <(find "$rec_dir" -maxdepth 1 -type f \( -iname '*.mp4' -o -iname '*.mkv' \) -printf '%T@\t%p\n' 2>/dev/null | sort -rn | head -5 | cut -f2-)
  jq -n \
    --arg aspect "$(sget aspect 9:16)" \
    --arg project "$(project_dir)" \
    --arg disk "$(disk_free)" \
    --argjson mic "$(mic_muted)" \
    --argjson recent "$recent" \
    '{aspect:$aspect, project:$project, disk:$disk, micMuted:$mic, recent:$recent}'
}

launch() { setsid -f "$@" >/dev/null 2>&1; }

case "${1:-status}" in
status) cmd_status ;;
aspect)
  if [ -n "${2:-}" ]; then sset aspect "$2"; else sget aspect 9:16; fi
  ;;
project)
  if [ -n "${2:-}" ]; then sset project "$2"; else project_dir; fi
  ;;
golive)
  if command -v obs >/dev/null; then
    launch obs --startstreaming
  else
    notify "OBS not installed" "Install it from the Influencer bundle"
  fi
  ;;
edit)
  if ed="$(first_cmd kdenlive davinci-resolve shotcut losslesscut)"; then
    launch "$ed"
  else
    notify "No editor found" "Install kdenlive from the Influencer bundle"
  fi
  ;;
reformat-last)
  src="$(newest_recording)"
  if [ -z "$src" ]; then
    notify "No recordings" "Record something first"
    exit 0
  fi
  dims="$(aspect_dims "$(sget aspect 9:16)")"
  w="${dims%:*}"
  h="${dims#*:}"
  out="${src%.*}_${w}x${h}.mp4"
  notify "Reformatting" "$(basename "$src") to $(sget aspect 9:16)"
  if ffmpeg -nostdin -y -i "$src" -vf "scale=${w}:${h}:force_original_aspect_ratio=increase,crop=${w}:${h},setsar=1" -c:a copy "$out" 2>/dev/null; then
    notify "Reformatted" "$(basename "$out")"
    command -v nautilus >/dev/null && launch nautilus --select "$out"
  else
    notify "Reformat failed" "$(basename "$src")"
  fi
  ;;
caption-last)
  src="$(newest_recording)"
  if [ -z "$src" ]; then
    notify "No recordings" "Record something first"
    exit 0
  fi
  if ! wc="$(first_cmd whisper-cli whisper.cpp main)"; then
    notify "whisper.cpp not installed" "Install it from the Influencer bundle"
    exit 0
  fi
  wav="$(mktemp --suffix=.wav)"
  notify "Transcribing" "$(basename "$src")"
  if ffmpeg -nostdin -y -i "$src" -ar 16000 -ac 1 -c:a pcm_s16le "$wav" 2>/dev/null &&
    "$wc" -f "$wav" -osrt -of "${src%.*}" >/dev/null 2>&1; then
    notify "Captioned" "$(basename "${src%.*}").srt"
  else
    notify "Caption failed" "$(basename "$src")"
  fi
  rm -f "$wav"
  ;;
reveal)
  if [ -n "${2:-}" ] && command -v nautilus >/dev/null; then launch nautilus --select "$2"; fi
  ;;
open-project)
  if command -v nautilus >/dev/null; then launch nautilus "$(project_dir)"; fi
  ;;
mic-toggle)
  if command -v wpctl >/dev/null; then wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle; fi
  ;;
fx-toggle)
  if ! command -v easyeffects >/dev/null; then
    notify "EasyEffects not installed" "Install it from the Influencer bundle"
    exit 0
  fi
  if [ "$(sget fx on)" = on ]; then
    easyeffects -b 1 >/dev/null 2>&1
    sset fx off
  else
    easyeffects -b 2 >/dev/null 2>&1
    sset fx on
  fi
  ;;
*)
  echo "usage: ryoku-creator-deck status|aspect|project|golive|edit|reformat-last|caption-last|reveal|open-project|mic-toggle|fx-toggle" >&2
  exit 2
  ;;
esac

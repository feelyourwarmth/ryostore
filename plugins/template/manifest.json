{
  "id": "template",
  "name": "Template Plugin",
  "version": "0.1.0",
  "author": "Your Name <you@example.com>",
  "description": "Minimal example plugin to copy when starting a new one.",
  "license": "MIT",
  "tags": ["example", "desktop-widget"],
  "official": false,
  "entryPoints": {
    "main": "service/Main.qml",
    "content": "content/Widget.qml"
  },
  "files": [
    "assets/preview-widget.png"
  ],
  "capabilities": {
    "densities": ["compact"]
  },
  "hosts": ["desktopWidget"],
  "defaults": {
    "host": "desktopWidget",
    "desktopWidget": { "bg": "card" },
    "icon": "extension",
    "label": "Template"
  },
  "metadata": {
    "settings": [
      { "key": "greeting", "type": "text", "label": "Greeting", "group": "Template", "default": "Hello from a Ryoku plugin", "placeholder": "Shown at the top of the tile" }
    ]
  }
}

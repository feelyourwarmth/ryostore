{
  "schema": 1,
  "id": "obsidian",
  "category": "plugins",
  "version": "1.3.0",
  "destination": "ryoku/plugins/obsidian",
  "name": "Obsidian",
  "author": "Ryoku Team <hello@ryoku.sh>",
  "description": "Capture into your Obsidian vault from the desktop - daily notes, quick notes and tasks, screenshots and voice memos - as a canvas of tappable workflow blocks.",
  "license": "MIT",
  "tags": [
    "obsidian",
    "notes",
    "productivity",
    "desktop-widget"
  ],
  "official": true,
  "entryPoints": {
    "main": "service/Main.qml",
    "content": "content/Widget.qml"
  },
  "capabilities": {
    "densities": [
      "compact"
    ]
  },
  "hosts": [
    "desktopWidget"
  ],
  "defaults": {
    "host": "desktopWidget",
    "desktopWidget": {
      "bg": "none"
    },
    "icon": "file",
    "label": "Obsidian"
  },
  "commands": [
    "bin/ryoku-obsidian"
  ],
  "dependencies": {
    "commands": [
      "jq",
      "xdg-open",
      "wl-paste",
      "ffmpeg"
    ],
    "optional": [
      "zenity"
    ]
  },
  "metadata": {
    "settings": [
      {
        "key": "accent",
        "type": "choice",
        "label": "Accent",
        "group": "Style",
        "default": "brand",
        "options": [
          {
            "value": "brand",
            "label": "Vermillion"
          },
          {
            "value": "wallust",
            "label": "Wallust"
          },
          {
            "value": "mono",
            "label": "Mono"
          }
        ]
      },
      {
        "key": "vault",
        "type": "text",
        "label": "Vault path",
        "group": "Vault",
        "default": "",
        "placeholder": "Pick it on the widget, or type a full path"
      },
      {
        "key": "inbox",
        "type": "text",
        "label": "Capture note",
        "group": "Vault",
        "default": "",
        "placeholder": "Inbox.md (blank = today's note)"
      }
    ]
  },

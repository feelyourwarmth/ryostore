#!/usr/bin/env bash
# Local-first Obsidian bridge for the ryoku obsidian desktop widget. One verb per
# call; one JSON object on stdout. Any failure still exits 0 with {"error":"..."}
# so the widget's service keeps its last good state and never blanks the tile.
#
#   ryoku-obsidian detect
#   ryoku-obsidian vault-info   <vaultPath>
#   ryoku-obsidian list-notes   <vaultPath> [query] [limit]
#   ryoku-obsidian daily        <vaultPath> <vaultName>
#   ryoku-obsidian note         <vaultPath> <vaultName> <rel> [templateRel]
#   ryoku-obsidian append       <vaultPath> <vaultName> <relOrEmpty> <text>
#   ryoku-obsidian open         <vaultName> <rel>
#   ryoku-obsidian templates    <vaultPath>
#   ryoku-obsidian graph        <vaultPath> [limit]
#   ryoku-obsidian paste-image  <vaultPath> <vaultName> <relOrEmpty>
#   ryoku-obsidian record-audio <vaultPath> <outName>
#
# Everything is read from and written to the user's own vault on disk; the only
# thing that leaves the machine is the obsidian:// URI handed to xdg-open, which
# Obsidian itself handles. No network, no accounts, no telemetry.
#
# The widget's service (not this script) spawns commands directly (no shell), so
# argv elements may safely contain spaces, quotes, and newlines.
set -uo pipefail

emit_error() { jq -cn --arg e "$1" '{error: $e}'; exit 0; }

command -v jq >/dev/null 2>&1 || { printf '{"error":"jq not found"}\n'; exit 0; }

cfg_home="${XDG_CONFIG_HOME:-$HOME/.config}"

# ── date/format helpers ──────────────────────────────────────────────────────
# Resolve a Moment.js format string (as Obsidian stores it) to a string for
# today's date. Tokens are mapped longest-first into control-char sentinels
# before any value is substituted, so an inserted month/weekday name (which
# itself contains token letters) can never be re-tokenised. Bracket-escaped
# literals ([Week]) are not supported; the common date/time tokens are.
moment_date() {
	local fmt="$1"
	local s1=$'\001' s2=$'\002' s3=$'\003' s4=$'\004' s5=$'\005' s6=$'\006'
	local s7=$'\007' s8=$'\010' s9=$'\011' s10=$'\013' s11=$'\014' s12=$'\016'
	local s13=$'\017' s14=$'\020' s15=$'\021' s16=$'\022' s17=$'\023' s18=$'\024'
	local o="$fmt"
	# tokenise, longest token per letter-family first.
	o="${o//YYYY/$s1}"; o="${o//YY/$s2}"
	o="${o//MMMM/$s3}"; o="${o//MMM/$s4}"; o="${o//MM/$s5}"; o="${o//M/$s6}"
	o="${o//DD/$s7}";   o="${o//D/$s8}"
	o="${o//dddd/$s9}"; o="${o//ddd/$s10}"; o="${o//dd/$s11}"
	o="${o//HH/$s12}";  o="${o//H/$s13}"
	o="${o//hh/$s14}";  o="${o//h/$s15}"
	o="${o//mm/$s16}";  o="${o//ss/$s17}"
	o="${o//A/$s18}"
	# substitute values (sentinels are unique, so order is irrelevant now).
	o="${o//$s1/$(date +%Y)}";  o="${o//$s2/$(date +%y)}"
	o="${o//$s3/$(date +%B)}";  o="${o//$s4/$(date +%b)}"
	o="${o//$s5/$(date +%m)}";  o="${o//$s6/$(date +%-m)}"
	o="${o//$s7/$(date +%d)}";  o="${o//$s8/$(date +%-d)}"
	o="${o//$s9/$(date +%A)}";  o="${o//$s10/$(date +%a)}"; o="${o//$s11/$(date +%a)}"
	o="${o//$s12/$(date +%H)}"; o="${o//$s13/$(date +%-H)}"
	o="${o//$s14/$(date +%I)}"; o="${o//$s15/$(date +%-I)}"
	o="${o//$s16/$(date +%M)}"; o="${o//$s17/$(date +%S)}"
	o="${o//$s18/$(date +%p)}"
	printf '%s' "$o"
}

# Read a JSON string field from a file, print $2 (default) when absent/empty.
json_get() {
	local file="$1" filter="$2" def="${3:-}" v
	[ -f "$file" ] || { printf '%s' "$def"; return; }
	v="$(jq -r "$filter // empty" "$file" 2>/dev/null || true)"
	[ -n "$v" ] && printf '%s' "$v" || printf '%s' "$def"
}

# ── vault config resolution ──────────────────────────────────────────────────
# Daily-notes config: folder, Moment format, template (core "Daily notes"
# plugin, stored at .obsidian/daily-notes.json).
daily_folder()   { json_get "$1/.obsidian/daily-notes.json" '.folder' ""; }
daily_format()   { json_get "$1/.obsidian/daily-notes.json" '.format' "YYYY-MM-DD"; }
daily_template() { json_get "$1/.obsidian/daily-notes.json" '.template' ""; }
# Templates plugin date/time formats (.obsidian/templates.json).
tpl_datefmt()    { json_get "$1/.obsidian/templates.json" '.dateFormat' "YYYY-MM-DD"; }
tpl_timefmt()    { json_get "$1/.obsidian/templates.json" '.timeFormat' "HH:mm"; }
# Attachment folder (.obsidian/app.json; "" = vault root, "./x" = beside note).
attach_setting() { json_get "$1/.obsidian/app.json" '.attachmentFolderPath' ""; }

# Absolute attachment dir for a note (relPath may be empty = vault root note).
attach_dir_for() {
	local vault="$1" relNote="${2:-}" setting
	setting="$(attach_setting "$vault")"
	case "$setting" in
		"")        printf '%s' "$vault" ;;                       # vault root
		"./")      printf '%s' "$vault/$(dirname "$relNote")" ;; # note folder
		"./"*)     printf '%s' "$vault/$(dirname "$relNote")/${setting#./}" ;;
		/*)        printf '%s' "$setting" ;;                     # absolute
		*)         printf '%s' "$vault/$setting" ;;              # vault-relative
	esac
}

# Apply core template placeholders to a template file's content on stdin-less
# read: {{title}}, {{date}}, {{time}}, {{date:FMT}}, {{time:FMT}}.
apply_template() {
	local vault="$1" tplRel="$2" title="$3" body tpl
	[ -n "$tplRel" ] || return 1
	# Obsidian stores the template path without the .md extension.
	if [ -f "$vault/$tplRel" ]; then tpl="$vault/$tplRel"
	elif [ -f "$vault/$tplRel.md" ]; then tpl="$vault/$tplRel.md"
	else return 1; fi
	body="$(cat "$tpl")"
	local datefmt timefmt
	datefmt="$(tpl_datefmt "$vault")"; timefmt="$(tpl_timefmt "$vault")"
	# custom-format placeholders first ({{date:FMT}} / {{time:FMT}}).
	local m fmt val
	while IFS= read -r m; do
		fmt="${m#\{\{date:}"; fmt="${fmt%\}\}}"
		val="$(moment_date "$fmt")"
		body="${body//"$m"/$val}"
	done < <(grep -oE '\{\{date:[^}]*\}\}' <<<"$body" | sort -u || true)
	while IFS= read -r m; do
		fmt="${m#\{\{time:}"; fmt="${fmt%\}\}}"
		val="$(moment_date "$fmt")"
		body="${body//"$m"/$val}"
	done < <(grep -oE '\{\{time:[^}]*\}\}' <<<"$body" | sort -u || true)
	body="${body//\{\{title\}\}/$title}"
	body="${body//\{\{date\}\}/$(moment_date "$datefmt")}"
	body="${body//\{\{time\}\}/$(moment_date "$timefmt")}"
	printf '%s' "$body"
}

# Compute today's daily-note path relative to the vault (folder + formatted name).
daily_rel() {
	local vault="$1" folder name
	folder="$(daily_folder "$vault")"
	name="$(moment_date "$(daily_format "$vault")")"
	[ -n "$folder" ] && printf '%s/%s.md' "$folder" "$name" || printf '%s.md' "$name"
}

# Templates folder (.obsidian/templates.json; default "Templates").
templates_folder() { json_get "$1/.obsidian/templates.json" '.folder' "Templates"; }

# Ensure a note exists at relPath, seeding it from tplRel when creating (empty
# tplRel = a blank note). Prints 1 when it created the file, 0 when it existed.
ensure_note() {
	local vault="$1" rel="$2" tplRel="${3:-}" abs="$1/$2" title
	[ -f "$abs" ] && { printf '0'; return; }         # already there
	mkdir -p "$(dirname "$abs")"
	title="$(basename "$rel" .md)"
	if [ -n "$tplRel" ]; then
		apply_template "$vault" "$tplRel" "$title" >"$abs" 2>/dev/null || : >"$abs"
	else
		: >"$abs"
	fi
	printf '1'                                        # created
}

# resolve_launcher: fill LAUNCH[] with the command that hands an obsidian:// URI
# straight to the installed Obsidian. We launch the app directly rather than
# `xdg-open <uri>`, because a machine with no obsidian:// scheme handler
# registered sends the URI to the default web browser instead (the reported "it
# opens my browser, not Obsidian"). Direct launch needs no system registration,
# so the widget works out of the box and leaves nothing behind when removed.
# Returns 1 when no Obsidian is found, so the caller can fall back to xdg-open.
LAUNCH=()
resolve_launcher() {
	command -v obsidian >/dev/null 2>&1 && { LAUNCH=(obsidian); return 0; }
	if command -v flatpak >/dev/null 2>&1 && flatpak info md.obsidian.Obsidian >/dev/null 2>&1; then
		LAUNCH=(flatpak run md.obsidian.Obsidian); return 0
	fi
	[ -x /snap/bin/obsidian ] && { LAUNCH=(/snap/bin/obsidian); return 0; }
	local c
	for c in "$HOME/Applications"/Obsidian*.AppImage "$HOME/.local/bin/obsidian" \
	         /opt/Obsidian/obsidian /opt/obsidian/obsidian /usr/local/bin/obsidian; do
		[ -x "$c" ] && { LAUNCH=("$c"); return 0; }
	done
	return 1
}

# open_uri: open a vault (and optionally a note) in the installed Obsidian.
open_uri() {
	local name="$1" rel="${2:-}" q uri
	q="vault=$(jq -rn --arg s "$name" '$s|@uri')"
	[ -n "$rel" ] && q="$q&file=$(jq -rn --arg s "${rel%.md}" '$s|@uri')"
	uri="obsidian://open?$q"
	if resolve_launcher; then
		(setsid "${LAUNCH[@]}" "$uri" >/dev/null 2>&1 &) || true
	else
		(setsid xdg-open "$uri" >/dev/null 2>&1 &) || true
	fi
}

verb="${1:-}"; shift || true

case "$verb" in
detect)
	launcher=""; installed=false
	if resolve_launcher; then
		launcher="${LAUNCH[*]}"; installed=true
	fi
	vfile="$cfg_home/obsidian/obsidian.json"
	vaults='[]'
	if [ -f "$vfile" ]; then
		vaults="$(jq -c '
			(.vaults // {}) | to_entries
			| map({ name: (.value.path | rtrimstr("/") | split("/") | last),
			        path: .value.path,
			        open: (.value.open // false) })
			| sort_by(.open | not)' "$vfile" 2>/dev/null || echo '[]')"
		# obsidian is clearly present if it has ever registered a vault.
		[ "$vaults" = "[]" ] || installed=true
	fi
	jq -cn --argjson inst "$installed" --arg l "$launcher" --argjson v "$vaults" \
		'{ installed: $inst, launcher: $l, vaults: $v }'
	;;

vault-info)
	vault="${1:?vault path}"
	[ -d "$vault" ] || emit_error "vault not found"
	jq -cn \
		--arg folder "$(daily_folder "$vault")" \
		--arg format "$(daily_format "$vault")" \
		--arg template "$(daily_template "$vault")" \
		--arg attach "$(attach_setting "$vault")" \
		--arg dailyRel "$(daily_rel "$vault")" \
		'{ daily: { folder: $folder, format: $format, template: $template },
		   attachments: $attach, dailyRel: $dailyRel }'
	;;

list-notes)
	vault="${1:?vault path}"; query="${2:-}"; limit="${3:-60}"
	[ -d "$vault" ] || emit_error "vault not found"
	notes="$(find "$vault" -type f -name '*.md' \
		-not -path '*/.obsidian/*' -not -path '*/.trash/*' \
		-printf '%T@\t%P\n' 2>/dev/null | sort -rn | cut -f2-)"
	[ -n "$query" ] && notes="$(grep -iF -- "$query" <<<"$notes" || true)"
	notes="$(head -n "$limit" <<<"$notes")"
	jq -cn --rawfile n <(printf '%s' "$notes") \
		'{ notes: ($n | split("\n") | map(select(length > 0))) }'
	;;

daily)
	vault="${1:?vault path}"; name="${2:?vault name}"
	[ -d "$vault" ] || emit_error "vault not found"
	rel="$(daily_rel "$vault")"
	created="$(ensure_note "$vault" "$rel" "$(daily_template "$vault")")"
	open_uri "$name" "$rel"
	jq -cn --arg p "$rel" --argjson c "$([ "$created" = 1 ] && echo true || echo false)" \
		'{ path: $p, created: $c }'
	;;

append)
	vault="${1:?vault path}"; name="${2:?vault name}"; rel="${3:-}"; text="${4:-}"
	[ -d "$vault" ] || emit_error "vault not found"
	tpl=""
	[ -z "$rel" ] && { rel="$(daily_rel "$vault")"; tpl="$(daily_template "$vault")"; }
	ensure_note "$vault" "$rel" "$tpl" >/dev/null
	abs="$vault/$rel"
	# keep a blank line before the appended block when the note has content.
	[ -s "$abs" ] && [ -n "$(tail -c1 "$abs")" ] && printf '\n' >>"$abs"
	printf '%s\n' "$text" >>"$abs"
	# capture is silent by design — a quick note never yanks focus to Obsidian.
	jq -cn --arg p "$rel" '{ path: $p }'
	;;

open)
	name="${1:?vault name}"; rel="${2:-}"
	open_uri "$name" "$rel"
	jq -cn --arg p "$rel" '{ path: $p }'
	;;

note)
	vault="${1:?vault path}"; name="${2:?vault name}"; rel="${3:?note}"; tplRel="${4:-}"
	[ -d "$vault" ] || emit_error "vault not found"
	created="$(ensure_note "$vault" "$rel" "$tplRel")"
	open_uri "$name" "$rel"
	jq -cn --arg p "$rel" --argjson c "$([ "$created" = 1 ] && echo true || echo false)" \
		'{ path: $p, created: $c }'
	;;

templates)
	vault="${1:?vault path}"
	[ -d "$vault" ] || emit_error "vault not found"
	folder="$(templates_folder "$vault")"
	tdir="$vault/$folder"; list=""
	[ -d "$tdir" ] && list="$(find "$tdir" -type f -name '*.md' -printf '%P\n' 2>/dev/null | sort)"
	jq -cn --arg folder "$folder" --rawfile n <(printf '%s' "$list") \
		'{ folder: $folder,
		   templates: ($n | split("\n") | map(select(length > 0)) | map($folder + "/" + (. | rtrimstr(".md")))) }'
	;;

paste-image)
	vault="${1:?vault path}"; name="${2:?vault name}"; rel="${3:-}"
	command -v wl-paste >/dev/null 2>&1 || emit_error "wl-paste not found"
	[ -d "$vault" ] || emit_error "vault not found"
	# pick the best image MIME sitting on the clipboard.
	types="$(wl-paste --list-types 2>/dev/null || true)"
	mime=""; ext="png"
	for cand in image/png image/jpeg image/webp image/gif image/bmp image/tiff; do
		printf '%s\n' "$types" | grep -qiF "$cand" && { mime="$cand"; break; }
	done
	[ -n "$mime" ] || emit_error "no image on the clipboard"
	case "$mime" in
		image/jpeg) ext=jpg ;; image/webp) ext=webp ;; image/gif) ext=gif ;;
		image/bmp) ext=bmp ;; image/tiff) ext=tiff ;; *) ext=png ;;
	esac
	dir="$(attach_dir_for "$vault" "$rel")"; mkdir -p "$dir"
	fname="Pasted image $(date +%Y%m%d%H%M%S).$ext"
	wl-paste --type "$mime" >"$dir/$fname" 2>/dev/null || { rm -f "$dir/$fname"; emit_error "paste failed"; }
	[ -s "$dir/$fname" ] || { rm -f "$dir/$fname"; emit_error "clipboard image empty"; }
	tpl=""
	[ -z "$rel" ] && { rel="$(daily_rel "$vault")"; tpl="$(daily_template "$vault")"; }
	ensure_note "$vault" "$rel" "$tpl" >/dev/null
	abs="$vault/$rel"
	[ -s "$abs" ] && [ -n "$(tail -c1 "$abs")" ] && printf '\n' >>"$abs"
	printf '![[%s]]\n' "$fname" >>"$abs"
	# silent — the pasted image is waiting in the note next time you open it.
	jq -cn --arg a "$fname" --arg p "$rel" '{ attachment: $a, path: $p }'
	;;

record-audio)
	vault="${1:?vault path}"; outName="${2:?out name}"
	command -v ffmpeg >/dev/null 2>&1 || emit_error "ffmpeg not found"
	[ -d "$vault" ] || emit_error "vault not found"
	dir="$(attach_dir_for "$vault" "")"; mkdir -p "$dir"
	out="$dir/$outName"
	ffmpeg -hide_banner -loglevel error -y -f pulse -i default \
		-ac 1 -c:a libopus -b:a 32k "$out" >/dev/null 2>&1 &
	pid=$!
	# stop = a TERM/INT from the service; hand ffmpeg a clean quit so the .ogg
	# is finalised, then wait for it to actually exit before reporting.
	trap 'kill -INT "$pid" 2>/dev/null || true' TERM INT
	wait "$pid" 2>/dev/null || true
	while kill -0 "$pid" 2>/dev/null; do wait "$pid" 2>/dev/null || true; done
	trap - TERM INT
	ok=false; [ -s "$out" ] && ok=true
	jq -cn --arg a "$outName" --argjson ok "$ok" '{ attachment: $a, ok: $ok }'
	;;

graph)
	vault="${1:?vault path}"; limit="${2:-150}"
	[ -d "$vault" ] || emit_error "vault not found"
	tmpn="$(mktemp)"; tmpe="$(mktemp)"; trap 'rm -f "$tmpn" "$tmpe"' EXIT
	# One pass over the vault instead of a grep per file, so a large vault (a few
	# thousand notes) still builds the graph in well under a second. Node ids are
	# each note's relpath without .md; edges come from a single grep for
	# [[wikilinks]], mapped to "srcId<TAB>target" with any |alias or #heading cut.
	cd "$vault" || emit_error "vault not found"
	find . -type f -name '*.md' -not -path './.obsidian/*' -not -path './.trash/*' \
		| sed 's|^\./||; s/\.md$//' >"$tmpn"
	find . -type f -name '*.md' -not -path './.obsidian/*' -not -path './.trash/*' -print0 \
		| xargs -0 grep -HoE '\[\[[^]]+\]\]' 2>/dev/null \
		| sed 's|^\./||' \
		| awk '{
			i = index($0, ":[[")
			if (i == 0) next
			src = substr($0, 1, i - 1); sub(/\.md$/, "", src)
			tgt = substr($0, i + 3); sub(/\]\].*$/, "", tgt); sub(/[|#].*$/, "", tgt)
			gsub(/^[ \t]+|[ \t]+$/, "", tgt)
			if (tgt != "") print src "\t" tgt
		}' >"$tmpe"
	jq -cn --rawfile nraw "$tmpn" --rawfile eraw "$tmpe" --argjson limit "$limit" '
		($nraw | split("\n") | map(select(length > 0)) | unique) as $ids
		| ($ids | map({ (.): . }) | add // {}) as $byid
		| ($ids | map({ (. | split("/") | last): . }) | add // {}) as $bybase
		| ($eraw | split("\n") | map(select(length > 0)) | map(split("\t"))
			| map({ s: .[0], t: ($byid[.[1]] // $bybase[.[1]]) })
			| map(select(.t != null and .t != .s)) | unique) as $links
		| ($links | reduce .[] as $l ({}; .[$l.s] += 1 | .[$l.t] += 1)) as $deg
		| ($ids | map({ id: ., label: (. | split("/") | last), deg: ($deg[.] // 0) })
			| sort_by(-.deg) | .[0:$limit]) as $nodes
		| ($nodes | map(.id) | map({ (.): true }) | add // {}) as $keep
		| { total: ($ids | length), nodes: $nodes, links: ($links | map(select($keep[.s] and $keep[.t]))) }
	'
	;;

*)
	emit_error "unknown verb: $verb"
	;;
esac

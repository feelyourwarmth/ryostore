{
  "schema": 1,
  "id": "market",
  "category": "plugins",
  "version": "1.1.1",
  "destination": "ryoku/plugins/market",
  "name": "Market",
  "author": "Ryoku Team <hello@ryoku.sh>",
  "description": "Track a watchlist of stocks, indices, and crypto pairs on your desktop, in four faces - dossier, line, area, and minimal.",
  "license": "MIT",
  "tags": [
    "stocks",
    "crypto",
    "desktop-widget"
  ],
  "official": true,
  "entryPoints": {
    "main": "service/Main.qml",
    "content": "content/Widget.qml"
  },
  "capabilities": {
    "densities": [
      "compact"
    ]
  },
  "hosts": [
    "desktopWidget"
  ],
  "defaults": {
    "host": "desktopWidget",
    "desktopWidget": {
      "bg": "none"
    },
    "icon": "trending_up",
    "label": "Market"
  },
  "commands": [
    "bin/ryoku-market-fetch"
  ],
  "dependencies": {
    "commands": [
      "curl",
      "jq"
    ]
  },
  "metadata": {
    "settings": [
      {
        "key": "design",
        "type": "choice",
        "label": "Design",
        "group": "Market",
        "default": "dossier",
        "options": [
          {
            "value": "dossier",
            "label": "Dossier"
          },
          {
            "value": "line",
            "label": "Line"
          },
          {
            "value": "area",
            "label": "Area"
          },
          {
            "value": "minimal",
            "label": "Minimal"
          }
        ]
      },
      {
        "key": "symbols",
        "type": "text",
        "label": "Watchlist",
        "group": "Market",
        "default": "BTC-USD",
        "placeholder": "Up to six Yahoo tickers: BTC-USD, AAPL, ^GSPC"
      },
      {
        "key": "window",
        "type": "choice",
        "label": "Window",
        "group": "Market",
        "default": "1D",
        "options": [
          {
            "value": "1D",
            "label": "1 day"
          },
          {
            "value": "1W",
            "label": "1 week"
          },
          {
            "value": "1M",
            "label": "1 month"
          },
          {
            "value": "1Y",
            "label": "1 year"
          }
        ]
      },
      {
        "key": "refreshSec",
        "type": "slider",
        "label": "Refresh (s)",
        "group": "Data",
        "default": 60,
        "min": 30,
        "max": 600,
        "step": 30,
        "decimals": 0
      },
      {
        "key": "accent",
        "type": "choice",
        "label": "Accent",
        "group": "Style",
        "default": "wallpaper",
        "options": [
          {
            "value": "wallpaper",
            "label": "Wallpaper"
          },
          {
            "value": "brand",
            "label": "Brand"
          },
          {
            "value": "mono",
            "label": "Mono"
          }
        ]
      },
      {
        "key": "showGrid",
        "type": "toggle",
        "label": "Chart grid",
        "group": "Style",
        "default": true
      }
    ]
  },

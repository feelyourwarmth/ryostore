{
  "id": "media",
  "name": "Media",
  "version": "1.0.0",
  "author": "Ryoku Team <hello@ryoku.sh>",
  "description": "Now-playing for your desktop, in seven faces - dossier, vinyl, cassette, poster, looping GIF, minimal, and a live CAVA spectrum.",
  "license": "MIT",
  "tags": ["media", "mpris", "desktop-widget"],
  "official": true,
  "entryPoints": {
    "main": "service/Main.qml",
    "content": "content/Widget.qml"
  },
  "files": [
    "service/Spectrum.qml",
    "content/MediaDossier.qml",
    "content/MediaMinimal.qml",
    "content/MediaPoster.qml",
    "content/MediaVinyl.qml",
    "content/MediaCassette.qml",
    "content/MediaLoop.qml",
    "content/MediaSpectrum.qml",
    "content/Marquee.qml",
    "content/Transport.qml",
    "content/WaveSeek.qml",
    "content/SpectrumBars.qml",
    "content/SpectrumRing.qml",
    "assets/sample.gif",
    "assets/cover.jpg",
    "assets/preview-widget.png"
  ],
  "capabilities": {
    "densities": ["compact"]
  },
  "hosts": ["desktopWidget"],
  "defaults": {
    "host": "desktopWidget",
    "desktopWidget": { "bg": "none" },
    "icon": "music",
    "label": "Media"
  },
  "dependencies": { "commands": ["cava"] },
  "metadata": {
    "settings": [
      { "key": "design", "type": "choice", "label": "Design", "group": "Player", "default": "dossier", "options": [
        { "value": "dossier", "label": "Dossier" },
        { "value": "minimal", "label": "Minimal" },
        { "value": "poster", "label": "Poster" },
        { "value": "vinyl", "label": "Vinyl" },
        { "value": "cassette", "label": "Cassette" },
        { "value": "loop", "label": "Looping GIF" },
        { "value": "spectrum", "label": "Spectrum" }
      ] },
      { "key": "accent", "type": "choice", "label": "Accent", "group": "Player", "default": "wallust", "options": [
        { "value": "wallust", "label": "Wallust" },
        { "value": "brand", "label": "Brand" },
        { "value": "mono", "label": "Mono" }
      ] },
      { "key": "showSource", "type": "toggle", "label": "Show source", "group": "Player", "default": true },
      { "key": "showSeek", "type": "toggle", "label": "Show seek", "group": "Player", "default": true },
      { "key": "artRadius", "type": "slider", "label": "Art roundness", "group": "Art", "default": 14, "min": 0, "max": 48, "step": 1, "decimals": 0 },
      { "key": "posterFilter", "type": "choice", "label": "Poster filter", "group": "Poster", "default": "none", "options": [
        { "value": "none", "label": "None" },
        { "value": "mono", "label": "Mono" },
        { "value": "noir", "label": "Noir" },
        { "value": "sepia", "label": "Sepia" },
        { "value": "warm", "label": "Warm" },
        { "value": "cool", "label": "Cool" },
        { "value": "vivid", "label": "Vivid" },
        { "value": "fade", "label": "Fade" }
      ] },
      { "key": "gifPath", "type": "image", "label": "Loop GIF", "group": "Loop", "default": "", "placeholder": "Looping GIF; blank uses the bundled sample" },
      { "key": "spectrumOverlay", "type": "toggle", "label": "Spectrum overlay", "group": "Spectrum", "default": false },
      { "key": "spectrumBars", "type": "slider", "label": "Spectrum bars", "group": "Spectrum", "default": 48, "min": 16, "max": 64, "step": 4, "decimals": 0 }
    ]
  }
}

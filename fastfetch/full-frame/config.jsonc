// Full Frame - a wide grey box framing blue-dot system lines beside the Arch logo
// Ported for Ryoku from awesome-fastfetch-collection (configs/sofijacom-config/config.jsonc), MIT.
// ryoku:recolor keys=primary
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "arch",
    "color": {
      "1": "blue"
    },
    "padding": {
      "top": 2,
      "right": 3
    }
  },
  "display": {
    "separator": " \u25b8 ",

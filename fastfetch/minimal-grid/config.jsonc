// Minimal Grid - a quiet, logo-free readout that keeps the essentials legible
// in a narrow pane. Its two tones live in display.color and nowhere else.
// ryoku:recolor keys=primary title=foreground
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "none"
  },
  "display": {
    "color": {
      "keys": "#68c7c1",
      "title": "#ebeff0"
    },
    "key": { "width": 7 },
    "separator": "\u00b7"
  },
  "modules": [
    { "type": "custom", "format": "{#1;title}MINIMAL GRID{#}" },
    { "type": "os", "key": "os" },
    { "type": "kernel", "key": "kernel" },
    { "type": "cpu", "key": "cpu" },
    { "type": "memory", "key": "memory", "percent": { "type": 9 } },
    { "type": "disk", "key": "disk", "folders": "/", "percent": { "type": 9 } },
    { "type": "uptime", "key": "uptime" },
    { "type": "colors", "symbol": "diamond", "paddingLeft": 1 }
  ]
}

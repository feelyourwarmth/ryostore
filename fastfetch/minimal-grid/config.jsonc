{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "none"
  },
  "display": {
    "color": { "keys": "38;2;104;199;193" },
    "key": { "width": 7 },
    "separator": "·"
  },
  "modules": [
    { "type": "custom", "format": "\u001b[1;38;2;235;239;240m{#1}MINIMAL GRID\u001b[0m" },
    { "type": "os", "key": "os" },
    { "type": "kernel", "key": "kernel" },
    { "type": "cpu", "key": "cpu" },
    { "type": "memory", "key": "memory", "percent": { "type": 9 } },
    { "type": "disk", "key": "disk", "folders": "/", "percent": { "type": 9 } },
    { "type": "uptime", "key": "uptime" },
    { "type": "colors", "symbol": "diamond", "paddingLeft": 1 }
  ]
}
